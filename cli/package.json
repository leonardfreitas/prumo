{
  "name": "prumo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "prumo": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    ".prumo-templates"
  ],
  "scripts": {
    "lint": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "prumo": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "24.13.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
