NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# MISSING until `pnpm db:setup` creates a database; `pnpm dev` offers to run it.
DATABASE_URL=MISSING
AUTH_DATABASE_URL=MISSING
# Read by docker-compose.yml, not by the API: the port Postgres is published on.
POSTGRES_PORT=5432

BETTER_AUTH_SECRET=replace-this-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
# Set only when a mobile app talks to this API; it enables Better Auth's Expo plugin.
# MOBILE_APP_SCHEME=app
